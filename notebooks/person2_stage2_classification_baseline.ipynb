 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# CPRI Hackathon — Task 01: Person 2\n",
    "## P2-Stage 2: Valid vs Invalid Supervised Classification Baseline\n",
    "\n",
    "This notebook implements and compares **8 baseline supervised classification configurations** on the 1,000 historical training records using leakage-free **5-fold Stratified Cross-Validation**.\n",
    "\n",
    "### Key Principles:\n",
    "1. **Strict Target & ID Exclusion**: `Reference_Parameter`, `Test_ID`, and `Validity_Label` are strictly excluded from model feature matrices $X$.\n",
    "2. **Constant Feature Isolation**: Features with zero variance across training data (e.g. `non_finite_value`, `duplicate_full_row`, physical laws) are explicitly detected and removed from $X$.\n",
    "3. **Leakage-Free Pipelines**: All preprocessing (`SimpleImputer`, `StandardScaler`) occurs strictly inside each CV fold.\n",
    "4. **Class Imbalance Focus**: Evaluated primarily on **Invalid F1** and **Invalid Recall** (positive class = Invalid)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, sys, pandas as pd, numpy as np\n",
    "sys.path.insert(0, '../src')\n",
    "from stage2_features import load_training_data_with_flags, prepare_stage2_feature_sets\n",
    "from stage2_models import evaluate_rule_baseline, evaluate_model_cv\n",
    "\n",
    "dataset_path = '../data/CPRI_Hackathon_Screening_Dataset_PARTICIPANT.xlsx'\n",
    "df_flagged = load_training_data_with_flags(dataset_path)\n",
    "print(f'Training_Data: {len(df_flagged)} records loaded with Stage 1 quality flags.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Class balance check\n",
    "counts = df_flagged['Validity_Label'].value_counts()\n",
    "print('Class Balance:')\n",
    "print(counts)\n",
    "print(f'Valid: {counts.get(\"Valid\", 0)/len(df_flagged)*100:.2f}%, Invalid: {counts.get(\"Invalid\", 0)/len(df_flagged)*100:.2f}%')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature preparation & Constant Feature Detection\n",
    "prep = prepare_stage2_feature_sets(df_flagged)\n",
    "X_raw = prep['X_raw']\n",
    "X_quality = prep['X_raw_quality']\n",
    "y = prep['y']\n",
    "\n",
    "print(f'Raw Active Features ({len(prep[\"raw_cols_active\"]}): {prep[\"raw_cols_active\"]}')\n",
    "print(f'Quality Active Flags ({len(prep[\"quality_cols_active\"])}): {prep[\"quality_cols_active\"]}')\n",
    "print(f'Detected {len(prep[\"constant_features\"])} constant features (excluded from X).')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Execute 8 Baseline Configurations\n",
    "results = []
    "results.append(evaluate_rule_baseline(X_quality, y, 'definite_issue'))\n",
    "results.append(evaluate_rule_baseline(X_quality, y, 'definite_plus_duplicate'))\n",
    "results.append(evaluate_model_cv(X_raw, y, 'logistic_regression', 'Raw Inputs', config='balanced'))\n",
    "results.append(evaluate_model_cv(X_quality, y, 'logistic_regression', 'Raw + Quality Features', config='balanced'))\n",
    "results.append(evaluate_model_cv(X_raw, y, 'random_forest', 'Raw Inputs', config='balanced'))\n",
    "results.append(evaluate_model_cv(X_quality, y, 'random_forest', 'Raw + Quality Features', config='balanced'))\n",
    "results.append(evaluate_model_cv(X_raw, y, 'gradient_boosting', 'Raw Inputs'))\n",
    "results.append(evaluate_model_cv(X_quality, y, 'gradient_boosting', 'Raw + Quality Features'))\n",
    "\n",
    "summary = []\n",
    "for r in results:\n",
    "    summary.append({\n",
    "        'Model': r['model_name'],\n",
    "        'Feature_Set': r['feature_set'],\n",
    "        'Invalid_Precision': round(r['invalid_precision'], 4),\n",
    "        'Invalid_Recall': round(r['invalid_recall'], 4),\n",
    "        'Invalid_F1': round(r['invalid_f1'], 4),\n",
    "        'Macro_F1': round(r['macro_f1'], 4),\n",
    "        'Accuracy': round(r['accuracy'], 4),\n",
    "        'Balanced_Accuracy': round(r['balanced_accuracy'], 4)\n",
    "    })\n",
    "pd.DataFrame(summary)"
   ]
  }
 ],
